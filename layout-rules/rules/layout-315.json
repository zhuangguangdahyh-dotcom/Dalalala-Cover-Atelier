    "adaptive": [
      "标题原文、逐字字形与合理换行。",
      "素材在既定主体区域内的裁切和缩放。",
      "已选字体风格与已批准配色方案。",
      "跨平台比例对应的独立布局变体。"
    ],
    "optional": [
      "副标题、标签、角标和署名仅在不改变阅读顺序时出现。"
