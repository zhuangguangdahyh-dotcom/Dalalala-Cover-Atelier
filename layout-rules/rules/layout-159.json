  "layoutContract": {
    "primaryMechanism": "让主图或主色块覆盖画布边界，文字必须依附安全区而不削弱满幅冲击。",
    "dominantAxis": "full-bleed",
    "primaryFocus": "dominant-field",
    "readingPath": "largest-to-smallest",
    "locked": [
      "以“满出血版式”作为唯一主构图机制，不与其他编号的骨架混用。",
      "保持 full-bleed 主轴、dominant-field 焦点和 largest-to-smallest 阅读顺序。",
      "保持主标题、主体、辅助信息的视觉等级，不允许三个层级平均抢眼。",
      "先保护参考中的留白与主体识别区，再适配文字长度。"
    ],
    "adaptive": [
      "标题原文、逐字字形与合理换行。",
      "素材在既定主体区域内的裁切和缩放。",
      "已选字体风格与已批准配色方案。",
      "跨平台比例对应的独立布局变体。"
    ],
    "optional": [
      "副标题、标签、角标和署名仅在不改变阅读顺序时出现。"
    ],
    "forbidden": [
      "自由混合多个布局规则",
      "为容纳长标题改变主轴或主体左右关系",
      "拉伸整张参考图适配其他比例",
      "用装饰元素填满受保护留白",
      "让 AI 同时重新设计构图、字体和配色"
    ]
  },
  "runtime": {
